# Vorlage fuer die lokale Entwicklung.
# Eine Kopie dieser Datei unter dem Namen .env wird beim Start automatisch
# eingelesen (siehe config/settings.py). Bereits gesetzte Umgebungs-
# variablen haben Vorrang. Auf dem Server existiert die Datei nicht, dort
# kommen die Werte aus der Umgebung des Anbieters.
#
#     cp .env.example .env

# Schaltet den Fehlersuchmodus ein. Ohne diese Variable gilt Produktions-
# betrieb, und die Anwendung startet ohne SECRET_KEY nicht.
DEBUG=1

# Nur in der Produktion noetig. Lokal wird bei DEBUG=1 je Start ein
# Zufallswert erzeugt.
# SECRET_KEY=

# Verzeichnis der Datenbankdatei. In der Produktion das eingehaengte Volume.
# DATA_DIR=/data
